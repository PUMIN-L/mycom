# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local debug / scratch scripts — operator tooling, not for the repo
/test-*.js
/scratch/
/dummy.pdf

# patch/merge debris. A committed *.orig is a stale duplicate of a file that has
# since moved on, so a grep of the test suite finds matches in a file vitest
# never runs — the same class of false clean that a binary file gives you.
*.orig
*.rej
